#!/usr/bin/env bash
# job-suite: the cell body of the job-run verb `suite`. job-run runs it under the cell's lock / settle / setsid + timeout / sampler
# with KLT_CELL=<cell dir>. It also works by hand (without the lock and gates).
#
#   job-suite run <test-backend-ops> <args>     one full `test` mode run, split into SUITE_SHARDS processes (default: auto, see below)
#       balanced by the per-op seconds of the last full run on this machine ($SUITE_PROFILE, default
#       $KLT_HOME/suite-cache/optimes.json, refreshed by every full run). No profile yet: shards by op count from
#       `test-backend-ops --list-ops` (unbalanced; the run then records a profile). Shard i = the same command + `-o <ops>`
#       [+ `-p <first-param split>`] (suite-plan.py: exact cover, unseen ops included). Per-shard raw output in
#       <cell>/shards/<i>.{log,ts,err,rc}, plan in shards/plan.tsv, load / RSS samples in shards/mon.tsv. stdout = merged
#       test-backend-ops console output (one "N/M tests passed", union "Failing tests:", "Backend X: OK|FAIL", "k/n backends passed")
#       + a "suite: ..." line. Exit 0 only if every shard passed, none crashed, partition ok. Shards stay in the cell's process group:
#       the cell timeout / MEM_KILL / cancel reach every shard. With -o / -p / -j / --test-file in <args> the command runs
#       unsharded (one shard) and refreshes no profile.
#   job-suite lookup <test-backend-ops> <args>  result cache: prints the cache file and writes <cell>/stdout.log on a hit.
#
# Cache (CACHE=auto default | master | force | off) in $SUITE_CACHE_DIR (default $KLT_HOME/suite-cache): key = host + source commit
# + dirty diff hash + CMakeCache GGML_*/LLAMA_*/flags/compiler/glslc + glslc --version + Vulkan ICD path + sha256 of its driver .so
# + args + GGML_*/LLAMA_*/VK_* env. Stored after a run with rc 0, only for a clean tree whose HEAD is an ancestor of
# $SUITE_MASTER_REF (default origin/master) and whose build is up to date (ninja -n / make -n of test-backend-ops: nothing to
# build); CACHE=force stores / uses any tree (dirty: the diff hash is in the key); CACHE=off neither reads nor writes.
# Auto SUITE_SHARDS: 8, capped by MemAvailable (SUITE_RSS_GB=4 per shard + 6 GB margin) and, when both are set, by
# SUITE_VRAM_BUDGET_MIB / SUITE_VRAM_MIB (VRAM per shard; for machines with a small VRAM carve-out and a VRAM kill).
set -u
. "$(dirname "$(readlink -f "$0")")/../lib/klt-env.sh"
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; }
mode=${1:-}; shift || true
case $mode in run|lookup) ;; *) usage; exit 2;; esac
TOOLS=$(dirname "$(readlink -f "$0")"); D=${KLT_CELL:-$PWD}; SH=$D/shards
CD=${SUITE_CACHE_DIR:-$KLT_HOME/suite-cache}; PROF=${SUITE_PROFILE:-$CD/optimes.json}; MREF=${SUITE_MASTER_REF:-origin/master}
HOST=$(hostname)
BIN=${1:?test-backend-ops}; shift; ARGS=("$@")
CACHE=${CACHE:-auto}
DEVERR='DeviceLost|ErrorDeviceLost|Not enough memory for command submission|BO_VA|ring .* timeout|GPU reset|device wedged'

sha() { sha256sum "$@" 2>/dev/null | awk '{print $1}' | sha256sum | cut -c1-16; }
keyinfo() {   # -> sets KEYF (fields text), KEY, ELIG (1/0), WHY, COMMIT
  local b bd cc="" x src dirty diffh up icd lib gl
  b=$(readlink -f "$(command -v "$BIN" || echo "$BIN")"); bd=$(dirname "$b")
  for x in "$bd/.." "$bd/../.." "$bd"; do [ -f "$x/CMakeCache.txt" ] && { cc=$(readlink -f "$x/CMakeCache.txt"); break; }; done
  ELIG=0; WHY=""; COMMIT=nogit
  [ -n "$cc" ] || { WHY="no CMakeCache.txt next to $b"; KEY=""; return; }
  src=$(sed -n 's/^CMAKE_HOME_DIRECTORY:INTERNAL=//p' "$cc")
  COMMIT=$(git -C "$src" rev-parse HEAD 2>/dev/null) || { WHY="$src is not a git tree"; KEY=""; COMMIT=nogit; return; }
  dirty=$(git -C "$src" status --porcelain 2>/dev/null | wc -l); diffh=clean
  [ "$dirty" -gt 0 ] && diffh=$( { git -C "$src" diff HEAD; git -C "$src" status --porcelain; } 2>/dev/null | sha256sum | cut -c1-16)
  if [ -f "$(dirname "$cc")/build.ninja" ]; then ninja -C "$(dirname "$cc")" -n test-backend-ops 2>/dev/null | grep -q 'no work to do' && up=1 || up=0
  else x=$(cmake --build "$(dirname "$cc")" --target test-backend-ops -- -n 2>&1) && ! grep -qE 'Building|Linking' <<<"$x" && up=1 || up=0; fi
  icd=${SUITE_ICD:-${VK_ICD_FILENAMES:-system}}; lib=""
  if [ -r "$icd" ]; then lib=$(python3 -c 'import json,os,sys; p=json.load(open(sys.argv[1]))["ICD"]["library_path"]; print(p if os.path.isabs(p) else os.path.join(os.path.dirname(sys.argv[1]),p))' "$icd" 2>/dev/null); fi
  gl=$(sed -n 's/^Vulkan_GLSLC_EXECUTABLE:[A-Z]*=//p' "$cc" | head -1)
  KEYF="host=$HOST
commit=$COMMIT
dirty=$diffh
src=$src
cmake=$(grep -E '^(GGML_[A-Z0-9_]+|LLAMA_[A-Z0-9_]+|CMAKE_BUILD_TYPE|CMAKE_C_FLAGS|CMAKE_CXX_FLAGS|CMAKE_C_COMPILER|CMAKE_CXX_COMPILER|Vulkan_GLSLC_EXECUTABLE|BUILD_SHARED_LIBS):' "$cc" | sort | sha256sum | cut -c1-16)
glslc=$gl $("$gl" --version 2>/dev/null | head -1)
icd=$icd lib=${lib:-?} libsha=$( [ -n "$lib" ] && sha "$lib" || echo none)
args=${ARGS[*]}
env=$(env | grep -E '^(GGML_|LLAMA_|VK_)' | grep -vE '^(VK_ICD_FILENAMES|VK_DRIVER_FILES)=' | sort | tr '\n' ' ')"
  KEY=$(printf '%s' "$KEYF" | sha256sum | cut -c1-16)
  local mref=""; git -C "$src" rev-parse -q --verify "$MREF" >/dev/null && mref=$MREF
  case $CACHE in
    off) WHY="CACHE=off";;
    force) ELIG=1; WHY="CACHE=force";;
    *) if [ "$dirty" -gt 0 ]; then WHY="dirty tree ($dirty paths)"
       elif [ -z "$mref" ]; then WHY="no ref $MREF in $src (set SUITE_MASTER_REF)"
       elif ! git -C "$src" merge-base --is-ancestor HEAD "$mref"; then WHY="HEAD ${COMMIT:0:9} is not on $mref"
       elif [ "$up" != 1 ]; then WHY="build $(dirname "$cc") is not up to date with its tree"
       else ELIG=1; WHY="$mref ${COMMIT:0:9} clean, build up to date"; fi;;
  esac; }
cfile() { echo "$CD/${COMMIT:0:12}-$KEY.txt"; }

if [ "$mode" = lookup ]; then
  mkdir -p "$D"; keyinfo
  { echo "cache lookup $(date -u +%FT%TZ): key=${KEY:-none} eligible=$ELIG ($WHY)"; } >> "$D/cache.txt"
  [ "$ELIG" = 1 ] && [ -n "$KEY" ] && [ -r "$(cfile)" ] || exit 1
  f=$(cfile); dt=$(sed -n 's/^date=//p' "$f" | head -1); src=$(sed -n 's/^record=//p' "$f" | head -1)
  sed -n '/^---- output$/,$p' "$f" | tail -n +2 | sed -E "s|^(  [0-9]+/[0-9]+ tests passed)$|\1 (cached $dt)|" > "$D/stdout.log"
  echo "suite: cached $dt from $src (key $KEY, $WHY)" >> "$D/stdout.log"
  echo "cache HIT $f" >> "$D/cache.txt"; echo "$f"; exit 0
fi

mkdir -p "$SH" "$CD"; : > "$SH/plan.txt"
for a in "${ARGS[@]}"; do case $a in perf|grad|support|census) echo "suite: mode '$a' is not supported (test mode only): FAIL"; exit 2;; esac; done
filt=0; for a in "${ARGS[@]}"; do case $a in -o|-p|-j|--test-file) filt=1;; esac; done
binsha=$(b=$(readlink -f "$(command -v "$BIN" || echo "$BIN")"); sha "$b" "$(dirname "$b")"/libggml*.so)
keyinfo; echo "cache: key=${KEY:-none} eligible=$ELIG ($WHY)" > "$SH/cache.txt"
# shard count
ma=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); rss=${SUITE_RSS_GB:-4}
N=${SUITE_SHARDS:-auto}; [ "$N" = auto ] && N=8
[[ $N =~ ^[1-9][0-9]*$ ]] || { echo "suite: bad SUITE_SHARDS=$N: FAIL"; exit 2; }
capm=$(( (ma - 6) / rss )); [ $capm -lt 1 ] && capm=1; [ "$N" -gt $capm ] && { echo "suite: SUITE_SHARDS $N -> $capm (MemAvailable ${ma}G, ${rss}G per shard)" >&2; N=$capm; }
if [ -n "${SUITE_VRAM_MIB:-}" ] && [ -n "${SUITE_VRAM_BUDGET_MIB:-}" ]; then capv=$(( SUITE_VRAM_BUDGET_MIB / SUITE_VRAM_MIB )); [ $capv -lt 1 ] && capv=1; [ "$N" -gt "$capv" ] && N=$capv; fi
note=""; PIN=$PROF
[ $filt = 1 ] && { N=1; note="filtered args: unsharded"; }
if [ "$N" -gt 1 ] && [ ! -r "$PROF" ]; then   # no profile: uniform weight per op name from --list-ops
  "$BIN" --list-ops 2>/dev/null | awk '/^  [A-Za-z0-9_]+$/{print $1}' > "$SH/ops.txt"
  if [ -s "$SH/ops.txt" ] && python3 "$TOOLS/suite-plan.py" uniform "$SH/ops.txt" "$SH/uniform.json" >> "$SH/plan.txt" 2>&1; then
    PIN=$SH/uniform.json; note="no op profile yet: sharded by op count (this run records one)"
  else N=1; note="no op profile and no --list-ops: unsharded (this run records a profile)"; fi
fi
if [ "$N" -gt 1 ]; then python3 "$TOOLS/suite-plan.py" plan "$PIN" "$N" "$SH/plan.tsv" >> "$SH/plan.txt" 2>&1 || { cat "$SH/plan.txt"; echo "suite: plan failed: FAIL"; exit 1; }
  N=$(grep -c . "$SH/plan.tsv"); [ -n "$note" ] && echo "plan: $note" >> "$SH/plan.txt"
else printf '0\t-\t-\t0\tall%s\n' "${note:+ ($note)}" > "$SH/plan.tsv"; echo "plan: 1 shard${note:+ ($note)}" >> "$SH/plan.txt"; fi

PIDS=(); t0=$(date +%s.%N)
killall_shards() { local p; for p in "${PIDS[@]}"; do kill -TERM "$p" 2>/dev/null; done; }
trap 'killall_shards; exit 143' TERM INT
while IFS=$'\t' read -r i o p est lab; do
  x=(); [ "$o" != - ] && x+=(-o "$o"); [ "$p" != - ] && x+=(-p "$p")
  echo "shard $i: est ${est}s $lab | ${x[*]}" >> "$SH/plan.txt"
  rm -f "$SH/$i.log.done"
  "$BIN" "${ARGS[@]}" "${x[@]}" 2> "$SH/$i.err" > >(exec python3 -u "$TOOLS/suite-plan.py" ts "$SH/$i.log" "$SH/$i.ts") &
  PIDS[$i]=$!
done < "$SH/plan.tsv"
# monitor: load, RSS (sum and per-process peak), VRAM, shard device errors
GPU=$(klt_gpu_card 2>/dev/null)
echo "# time load1 nrun_shards rss_sum_mib hwm_max_mib vram_mib gtt_mib cpu_busy_pct" > "$SH/mon.tsv"
read -r _ u1 n1 s1 i1 _ < /proc/stat; dev=""
while :; do live=0; rs=0; hw=0
  for p in "${PIDS[@]}"; do [ -r /proc/$p/status ] || continue; live=$((live+1))
    r=$(awk '/^VmRSS/{print $2}' /proc/$p/status); h=$(awk '/^VmHWM/{print $2}' /proc/$p/status)
    rs=$((rs + ${r:-0})); [ "${h:-0}" -gt $hw ] && hw=$h; done
  [ $live = 0 ] && break
  read -r _ u2 n2 s2 i2 _ < /proc/stat; cb=$(( (u2+n2+s2-u1-n1-s1) * 100 / ( (u2+n2+s2+i2-u1-n1-s1-i1) > 0 ? (u2+n2+s2+i2-u1-n1-s1-i1) : 1 ) )); u1=$u2; n1=$n2; s1=$s2; i1=$i2
  echo "$(date -u +%T) $(cut -d' ' -f1 /proc/loadavg) $live $((rs/1024)) $((hw/1024)) $(( $(cat $GPU/mem_info_vram_used 2>/dev/null || echo 0) >> 20 )) $(( $(cat $GPU/mem_info_gtt_used 2>/dev/null || echo 0) >> 20 )) $cb" >> "$SH/mon.tsv"
  dev=$(cat "$SH"/*.err 2>/dev/null | grep -aE "$DEVERR" | head -1) && [ -n "$dev" ] && { echo "suite: device error in a shard: $dev" >&2; killall_shards; break; }
  sleep 5; done
for i in "${!PIDS[@]}"; do wait "${PIDS[$i]}"; echo $? > "$SH/$i.rc"; done
for i in "${!PIDS[@]}"; do for k in $(seq 60); do [ -e "$SH/$i.log.done" ] && break; sleep 0.5; done; done
wall=$(awk -v a="$t0" -v b="$(date +%s.%N)" 'BEGIN{printf "%.1f", b-a}')
for i in "${!PIDS[@]}"; do [ -s "$SH/$i.err" ] && sed "s/^/[shard $i] /" "$SH/$i.err" >&2; done
pout=""; [ $filt = 0 ] && pout=$SH/optimes.json
python3 "$TOOLS/suite-plan.py" merge "$SH" "$N" "$wall" "$PROF" "$pout" "$binsha" "${ARGS[*]}" "$HOST" > "$SH/merged.out"; rc=$?
cat "$SH/merged.out"
awk 'NR>1{n++; if($2>l)l=$2; s+=$8; if($4>r)r=$4; if($5>h)h=$5; if($6>v)v=$6} END{if(n) printf "suite: mon load1_max=%.1f cpu_busy_mean=%.0f%% rss_sum_peak=%dMiB rss_shard_peak=%dMiB vram_peak=%dMiB\n", l, s/n, r, h, v}' "$SH/mon.tsv"
# profile: a full (unfiltered) complete run replaces this machine's op profile (temp + mv)
if [ -n "$pout" ] && [ -s "$pout" ] && [ -z "$dev" ]; then mkdir -p "$(dirname "$PROF")"; cp "$pout" "$PROF.tmp.$$" && mv -f "$PROF.tmp.$$" "$PROF"; fi
# cache store
if [ $rc = 0 ] && [ "$ELIG" = 1 ] && [ -n "$KEY" ] && [ -z "$dev" ]; then f=$(cfile)
  { echo "date=$(date -u +%FT%TZ)"; echo "record=$(dirname "$(dirname "$D")")"; echo "cell=$(basename "$D")"; echo "key=$KEY"; echo "$KEYF"; echo "---- output"
    grep -avE '^  [A-Za-z0-9_]+\(.*\): ' "$SH/merged.out" | grep -v '^suite: '; } > "$f.tmp.$$" && mv -f "$f.tmp.$$" "$f"
  echo "suite: cache stored $f"
else echo "suite: cache not stored (rc=$rc, $WHY)"; fi
[ -n "$dev" ] && exit 70
exit $rc
