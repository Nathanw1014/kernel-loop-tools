#version 450
// spin.comp: the vkq spin kernel: a dependent FMA chain per invocation (latency bound, one wave per workgroup), result stored so it is live.
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { uint iters; uint off; } pc;
layout(std430, binding = 0) buffer Buf { float d[]; };
void main() {
    float x = float(gl_GlobalInvocationID.x) * 1e-6;
    const float a = 0.9999999, b = 1e-7;
    for (uint i = 0; i < pc.iters; ++i) {
        x = fma(x, a, b); x = fma(x, a, b); x = fma(x, a, b); x = fma(x, a, b);
    }
    d[pc.off + gl_GlobalInvocationID.x] = x;
}
