#version 450
// wmma_peak_i8.comp: int8 twin of wmma_peak.comp: register-operand 16x16x16 int8 x int8 -> int32 cooperative-matrix chains.
// Same spec constants (ITER, NVALU, NACC) and buffer contract; run with vkrun / peak.py.
// build: glslc -O --target-env=vulkan1.3 wmma_peak_i8.comp -o wmma_peak_i8.spv
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_control_flow_attributes : enable
layout(local_size_x = 256) in;
layout(binding = 0) buffer O { float o[]; };
layout(constant_id = 0) const uint ITER = 1024;
layout(constant_id = 1) const uint NVALU = 0;     // independent f32 fma per 8 WMMAs
layout(constant_id = 2) const uint NACC = 8;      // independent accumulators (chains)
void main() {
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A = coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(int8_t(int(o[gl_LocalInvocationID.x] * 1000.0)));
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B = coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(int8_t(int(o[gl_LocalInvocationID.x + 1] * 1000.0)));
    coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[8];
    [[unroll]] for (uint j = 0; j < 8; j++) acc[j] = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    float v[16];
    [[unroll]] for (uint k = 0; k < 16; k++) v[k] = o[gl_LocalInvocationID.x + 2 + k];
    const float c = o[300], d = o[301];
    for (uint i = 0; i < ITER; i++) {
        [[unroll]] for (uint j = 0; j < 8; j++) {
            if (j < NACC) acc[j] = coopMatMulAdd(A, B, acc[j]); else acc[0] = coopMatMulAdd(A, B, acc[0]);
        }
        [[unroll]] for (uint k = 0; k < NVALU; k++) v[k % 16] = fma(v[k % 16], c, d);
    }
    float s = 0.0;
    [[unroll]] for (uint j = 0; j < 8; j++) s += float(acc[j][0]);
    [[unroll]] for (uint k = 0; k < 16; k++) s += v[k];
    o[gl_GlobalInvocationID.x + 512] = s;
}
